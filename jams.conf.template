server {
    listen       8080;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # always revalidate so a new deploy is picked up, the hashed assets it points to are cached forever
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # backend, ${JAMS_BACKEND_URL} is filled in by the image's envsubst step on start
    location = /ws {
        proxy_pass ${JAMS_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # the socket can be quiet between songs, don't let nginx close it
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location = /stream {
        proxy_pass ${JAMS_BACKEND_URL};
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = /artwork {
        proxy_pass ${JAMS_BACKEND_URL};
        proxy_set_header Host $host;
    }

    # only these filenames are content-hashed, everything else (favicon, ...) uses nginx's default revalidation
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff;
    }

    error_page 404 /index.html;
}
